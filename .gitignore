node_modules/
dist/
.wrangler/
.dev.vars
*.local
.env
.env.*
!.env.example
local-data/
# The trailing `*` covers the per-shard output directories a local sharded run
# needs: `--output=test-results-shard2` alongside its own `E2E_AUTH_STATE`, so
# three shards in one checkout stop deleting each other's login state. See
# `e2e/constants.ts`.
test-results*/
playwright-report/
blob-report/
# The same directories under any other name.
#
# A run pointed at `--output=tr-s2` fell outside `test-results*/` and put two
# and a half thousand screenshots into a commit, because `git add -A` cannot
# tell a Playwright output directory from a source tree. The convention above
# is the one to use; this is the net under it, matched on the artifact
# directory Playwright always creates rather than on the name somebody chose.
.playwright-artifacts-*/
**/.playwright-artifacts-*/
# Screenshots from scripts/demo-screenshots.mjs. Regenerable from any build in
# a couple of minutes, several megabytes of PNG, and out of date the moment a
# screen changes — a CI artifact, never a committed one.
artifacts/
coverage/
.DS_Store
*.tsbuildinfo

# Local scratch: measurement and screenshot helpers, never part of the app.
*.local.mjs

# Downloaded season files for scripts/projection-v2-backtest.mjs. Public data,
# 100MiB of it, and re-downloadable — never committed.
.backtest-cache/

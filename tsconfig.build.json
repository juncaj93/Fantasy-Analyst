  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "e2e-production",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.production.config.ts"
  ]
}
